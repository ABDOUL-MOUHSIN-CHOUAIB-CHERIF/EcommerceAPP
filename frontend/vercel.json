{
  "buildCommand": "ng build --configuration=production",
  "outputDirectory": "dist/ecommerce/browser",
  "devCommand": "ng serve",
  "installCommand": "npm install --legacy-peer-deps",
  "framework": "angular",
  "routes": [
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/(.*)\\.(js|css|woff2|png|jpg|jpeg|gif|svg|ico)$",
      "dest": "/$1.$2"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}